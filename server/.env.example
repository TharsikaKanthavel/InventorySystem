DATABASE_URL=mysql://moolai:replace-with-strong-password@127.0.0.1:3306/moolai
PORT=3001
APP_ORIGIN=http://localhost:3001
NODE_ENV=development
# Set to 1 only behind one trusted reverse proxy in production.
TRUST_PROXY=0
# Required for initial seed; choose three DIFFERENT passwords of at least 12 characters.
SEED_ADMIN_PASSWORD=
SEED_BRANCH_A_PASSWORD=
SEED_BRANCH_B_PASSWORD=
# Set true only for a synthetic demonstration database.
SEED_SAMPLE_ASSETS=false
