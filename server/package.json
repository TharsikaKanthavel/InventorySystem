{
  "name": "@moolai/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "db:rollforward": "node --env-file-if-exists=.env db/rollforward.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.5",
    "mysql2": "^3.17.1"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
