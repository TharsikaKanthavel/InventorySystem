# Public deployment must use HTTPS. Replace with the exact browser origin.
DATABASE_URL=mysql://moolai:replace-with-url-encoded-password@127.0.0.1:3306/moolai
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://inventory.example.org
NODE_ENV=production
# Exactly one trusted reverse proxy; backend port must not be publicly accessible.
TRUST_PROXY=1
SEED_ADMIN_PASSWORD=
SEED_BRANCH_A_PASSWORD=
SEED_BRANCH_B_PASSWORD=
SEED_SAMPLE_ASSETS=false
